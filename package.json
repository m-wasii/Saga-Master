{
  "name": "saga-master",
  "version": "1.0.0",
  "description": "Saga Master, a declarative JSON saga orchestrator for REST and Kafka.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "demo": "node scripts/demo.js",
    "test": "tsc && node scripts/copy-assets.js && node --test tests/*.test.js",
    "swagger-autogen": "node ./docs/swagger.js"
  },
  "keywords": [
    "saga",
    "orchestrator",
    "kafka",
    "microservices"
  ],
  "author": "Muhammad Usman, Khuzaima Nawab, Muhammad Wasi",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "kafkajs": "^2.2.4",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/swagger-ui-express": "^4.1.6",
    "nodemon": "^3.0.1",
    "swagger-autogen": "^2.23.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.3"
  }
}
